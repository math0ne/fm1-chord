+/// Guest instructions each quadrature state is held: the firmware samples the encoders once per
+/// 11-column scan frame (~1.1 ms) and needs two equal frames before it counts a transition.
+const ENCODER_HOLD: u64 = 1_600_000;
+
+/// A 16-bit stereo 44.1 kHz WAV of the emulated DAC stream. Felucca writes Q15 samples
+/// shifted left by OUT_SHIFT (7) into the 24-bit DAC words (firmware/src/audio.c), so the
+/// shift back recovers them exactly; anything louder saturates.
+struct Wav {
+    file: std::io::BufWriter<std::fs::File>,
+    frames: u64,
+}
+impl Wav {
+    fn create(path: &std::path::Path) -> io::Result<Self> {
+        let mut file = std::io::BufWriter::new(std::fs::File::create(path)?);
+        file.write_all(&[0; 44])?;
+        Ok(Self { file, frames: 0 })
+    }
+    fn push(&mut self, left: i32, right: i32) -> io::Result<()> {
+        let sample = |word: i32| (word >> 7).clamp(i16::MIN as i32, i16::MAX as i32) as i16;
+        self.file.write_all(&sample(left).to_le_bytes())?;
+        self.file.write_all(&sample(right).to_le_bytes())?;
+        self.frames += 1;
+        Ok(())
+    }
+    fn finish(mut self) -> io::Result<()> {
+        let data = (self.frames * 4) as u32;
+        let mut header = Vec::with_capacity(44);
+        header.extend_from_slice(b"RIFF");
+        header.extend_from_slice(&(36 + data).to_le_bytes());
+        header.extend_from_slice(b"WAVEfmt ");
+        header.extend_from_slice(&16u32.to_le_bytes());
+        header.extend_from_slice(&1u16.to_le_bytes());
+        header.extend_from_slice(&2u16.to_le_bytes());
+        header.extend_from_slice(&44_100u32.to_le_bytes());
+        header.extend_from_slice(&(44_100u32 * 4).to_le_bytes());
+        header.extend_from_slice(&4u16.to_le_bytes());
+        header.extend_from_slice(&16u16.to_le_bytes());
+        header.extend_from_slice(b"data");
+        header.extend_from_slice(&data.to_le_bytes());
+        self.file.flush()?;
+        let file = self.file.get_mut();
+        std::io::Seek::seek(file, std::io::SeekFrom::Start(0))?;
+        file.write_all(&header)?;
+        file.flush()
+    }
